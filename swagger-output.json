{
  "openapi": "3.0.0",
  "info": {
    "title": "Garajım API",
    "version": "1.0.0",
    "description": "Araç bakım ve takip sistemi API dokümantasyonu"
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Geliştirme Sunucusu"
    }
  ],
  "paths": {
    "/araclar/listele": {
      "get": {
        "summary": "Tüm araçları listeler",
        "tags": [
          "Araçlar"
        ],
        "responses": {
          "200": {
            "description": "Araç listesi döndü"
          },
          "401": {
            "description": "Token eksik veya geçersiz"
          }
        }
      }
    },
    "/araclar/filtrele": {
      "get": {
        "summary": "Araç filtreleme işlemi",
        "tags": [
          "Araçlar"
        ],
        "responses": {
          "200": {
            "description": "Filtrelenmiş araç listesi"
          },
          "400": {
            "description": "Geçersiz filtre parametresi"
          }
        }
      }
    },
    "/araclar/ekle": {
      "post": {
        "summary": "Yeni araç ekler",
        "tags": [
          "Araçlar"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "marka": {
                    "type": "string"
                  },
                  "model": {
                    "type": "string"
                  },
                  "yil": {
                    "type": "integer"
                  }
                },
                "required": [
                  "marka",
                  "model"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Araç başarıyla eklendi"
          },
          "400": {
            "description": "İstek verisi hatalı"
          }
        }
      }
    },
    "/araclar/{id}": {
      "get": {
        "summary": "Tek araç getirir",
        "tags": [
          "Araçlar"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Araç bulundu"
          },
          "404": {
            "description": "Araç bulunamadı"
          }
        }
      },
      "put": {
        "summary": "Araç günceller",
        "tags": [
          "Araçlar"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Araç güncellendi"
          },
          "404": {
            "description": "Araç bulunamadı"
          }
        }
      },
      "delete": {
        "summary": "Araç siler",
        "tags": [
          "Araçlar"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Araç silindi"
          },
          "404": {
            "description": "Araç bulunamadı"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ]
}