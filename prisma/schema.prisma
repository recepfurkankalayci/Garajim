generator client {
  provider = "prisma-client-js"
}
generator erd {
  provider = "prisma-erd-generator"
  output   = "../docs/erd.svg" 
  theme    = "default"            
}
datasource db {
  provider = "postgresql"
}

model User{
    id Int @id  @default(autoincrement())
    email String @unique
    name String
    password String
    Cars Cars[]
}

model Cars{
    id Int @id @default(autoincrement())
    license_plate String @unique
    brand String
    model String
    year Int
    userID Int
    gkm Int

    user User @relation(fields: [userID], references: [id])
    care Care[]
}

model Care{
    id Int @id @default(autoincrement())
    header String 
    hkm Int
    cost Int
    transaction_date DateTime
    carID Int
    car Cars @relation(fields: [carID], references: [id])
}